<Window x:Class="ProcessesMonitor.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Справка" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                    <Run Text="ProcessesMonitor" FontWeight="Bold"/> 
                    <Run Text="- приложение для мониторинга и управления запущенными процессами компьютера."/>
                </TextBlock>
                
                <TextBlock Text="Основные функции:" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Margin="20,0,0,15">
                    <TextBlock Text="• Просмотр списка процессов с детальной информацией (память, потоки, процессорное время)." TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Отслеживание потоков выбранного процесса с их статусами и приоритетами." TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Отображение древовидной иерархии процессов (связь родитель-потомок)." TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Наглядная визуализация данных (Топ-10 процессов по потреблению памяти)." TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Поиск процессов по имени и удобная фильтрация системных служб." TextWrapping="Wrap" Margin="0,0,0,5"/>
                </StackPanel>
                
                <TextBlock Text="Управление:" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Margin="20,0,0,15">
                    <TextBlock Text="• Изменение приоритета выполнения процесса посредством выбора варианта из выпадающего списка на панели «Управление» с последующим подтверждением выбранного варианта нажатием кнопки «Применить»." TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Для редактирования маски CPU Affinity (выбор ядер процессора, на которых разрешено выполняться процессу) отмечаются соответствующие номеру ядра ячейки." TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Принудительное завершение выбранных процессов осуществляется нажатием кнопки «Завершить процесс»." TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="• Настройка интервала автоматического обновления таблиц (2, 5 или 10 секунд) осуществляется через выпадающий список вверху панели (над таблицей)." TextWrapping="Wrap" Margin="0,0,0,5"/>
                </StackPanel>
                
                <TextBlock Text="Примечание:" FontWeight="Bold" Foreground="DarkRed" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Margin="20,0,0,15" Foreground="DarkRed">
                    <Run Text="Будьте осторожны при завершении системных процессов или установке приоритета "/>
                    <Run Text="Realtime" FontWeight="Bold"/>
                    <Run Text=" — это может привести к нестабильной работе операционной системы."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        
        <Button Grid.Row="2" Content="Закрыть" HorizontalAlignment="Right" 
                Padding="15,5" Click="CloseButton_Click"/>
    </Grid>
</Window>