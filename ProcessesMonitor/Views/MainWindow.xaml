<Window x:Class="ProcessesMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProcessesMonitor.ViewModels"
        Title="ProcessesMonitor" Height="700" Width="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Name="HelpButton" Click="HelpButton_Click" ToolTip="Справка" Padding="6,4" Margin="2">
                    <TextBlock Text="?" FontWeight="Bold" FontSize="16"/>
                </Button>
            </ToolBar>
        </ToolBarTray>
        <TabControl Margin="10">
            <TabItem Header="Процессы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Верхняя панель управления -->
                        <RowDefinition Height="2*"/>    <!-- DataGrid процессов -->
                        <RowDefinition Height="*"/> <!-- DataGrid потоков -->
                        <RowDefinition Height="Auto"/> <!-- Панель управления выбранным процессом -->
                        <RowDefinition Height="Auto"/> <!-- Статус-бар -->
                    </Grid.RowDefinitions>
                    
                    <!-- Верхняя панель -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Width="200" Margin="0,0,10,0" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown">
                            <TextBox.ToolTip>Поиск по имени процесса</TextBox.ToolTip>
                        </TextBox>

                        <CheckBox Content="Только системные" Margin="0,0,10,0"
                                  IsChecked="{Binding ShowOnlySystem}"/>
                        
                        <Button Content="↻" Width="30" Margin="0,0,10,0"
                                Click="RefreshButton_Click" ToolTip="Обновить"/>
                    </StackPanel>
                    
                    <!-- Таблица процессов -->
                    <DataGrid Grid.Row="1"  Width="Auto" HorizontalAlignment="Left" 
                              ItemsSource="{Binding Processes}"
                              SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="100"/>
                            <DataGridTextColumn Header="Память" Binding="{Binding MemoryUsageFormatted}" Width="90"/>
                            <DataGridTextColumn Header="Потоки" Binding="{Binding ThreadCount}" Width="70"/>
                            <DataGridTextColumn Header="CPU Time" Binding="{Binding CpuTimeFormatted}" Width="100"/>
                        </DataGrid.Columns>
                        
                        <!-- Подсветка высокого приоритета -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                        <Setter Property="Background" Value="#FFFFE0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Priority}" Value="Realtime">
                                        <Setter Property="Background" Value="#FFCCCC"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    
                    <!-- На Grid.Row="2" разместить таблицу DataGrid потоков выбранного процесса -->
                    
                    <!-- Панель управления выбранным процессом -->
                    <Expander Grid.Row="3" VerticalAlignment="Bottom" Header="Управление процессом"
                              IsExpanded="False" Margin="0,5,0,0">
                        <StackPanel Margin="5">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Приоритет:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailablePriorities}"
                                          SelectedItem="{Binding SelectedProcess.Priority, Mode=TwoWay}"
                                          Width="120" Margin="0,0,10,0"/>
                                <Button Content="Применить" Click="ApplyPriority_Click"
                                        IsEnabled="{Binding CanChangePriority}"/>
                            </StackPanel>
                            
                            <Button Content="Завершить процесс" Click="KillButton_Click"
                                    Background="#FFD0D0" Foreground="DarkRed"
                                    IsEnabled="{Binding CanChangePriority}" Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>
                    
                    <!-- Статус -->
                    <StatusBar Grid.Row="4">
                        <TextBlock Text="{Binding Processes.Count, StringFormat='Процессов: {0}'}"/>
                    </StatusBar>
                </Grid>
            </TabItem>
            <TabItem Header="Иерархия">
                <!-- В виде TreeView визуализировать древо процессов (родитель-потомки)
                Сделать выделение родительского процесса для выбранного процесса
                Сделать отображение количества дочерних процессов -->
            </TabItem>
            <TabItem Header="Визуализация">
                <!-- Используя библиотеку LiveCharts визуализировать загрузку процессора по ядрам:
                Сделать диаграмму распределения памяти между процессами (топ-10); -->
            </TabItem>
        </TabControl>
    </DockPanel>
    
</Window>